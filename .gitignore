# Build artifacts
target/
*.class

# JUnit standalone jar (download from Maven Central; see build.sh)
tools/*.jar

# Raw downloaded datasets and large generated graphs (regenerate via datasets/*.py)
datasets/raw/
datasets/mico.lg
datasets/github.lg
datasets/github_struct.lg
datasets/derived/

# Third-party GraMi clone (used only to regenerate the oracle; keep reference/oracle/)
reference/GraMi/

# OS / editor / IDE cruft
.DS_Store
*.swp
*~
.idea/
*.iml

# Run logs and calibration scratch output (timestamped raw outputs;
# the consolidated final results stay under results/ and ARE tracked)
*.log
calibrate.*.out
results/RERUN_*.csv
results/SC?_2*.csv
results/SC?_..._*.csv

# Python bytecode
__pycache__/
*.pyc

# External programs fetched and built by tools/build_resum.py (not part of this repository)
third_party/
